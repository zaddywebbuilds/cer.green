# =============================================================================
# CER website — environment variables
#
# Copy to `.env.local` for local development. Never commit a file containing
# real values: `.env` and `.env*.local` are gitignored.
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else
# is server-only. Never put a credential behind a NEXT_PUBLIC_ prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs, the sitemap,
# Open Graph URLs and JSON-LD. Must match the production domain exactly,
# including whether it uses www.
NEXT_PUBLIC_SITE_URL=https://www.cer.green

# Controls indexation. Set to "production" ONLY on the live site.
# Any other value (or unset) makes robots.txt disallow everything, which is
# what keeps staging and preview deployments out of Google. This site builds
# with `output: export`, so there is no middleware and no `X-Robots-Tag`
# header: robots.txt is the whole mechanism. If a staging host must not be
# crawled under any circumstances, password-protect it at the host as well.
DEPLOY_ENV=development


# -----------------------------------------------------------------------------
# Forms (required in production)
#
# Forms submit directly to Web3Forms (https://web3forms.com), which delivers
# to the email address registered with the access key. Sign up free, enter
# enquiry@cer.green as the destination email, and copy the access key here.
# Add it as a GitHub Actions secret named WEB3FORMS_KEY for the deploy workflow.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_WEB3FORMS_KEY=


# -----------------------------------------------------------------------------
# Analytics (optional)
#
# Neither tag loads until the visitor consents to analytics cookies. Set the
# GTM container id OR the GA4 measurement id, not both — if GTM is present,
# GA4 is expected to be configured inside the container.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=


# -----------------------------------------------------------------------------
# Client Portal (optional)
#
# Absolute URL of the authenticated portal application. When unset, the portal
# page routes visitors to email rather than linking to a route that does not
# exist. The portal is a separate secure application — client documents must
# never be served from this site.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_PORTAL_URL=


# -----------------------------------------------------------------------------
# Sanity CMS (optional — not required to run the site)
#
# The site currently reads content from /content via lib/content.ts. These are
# needed only once content editing moves into Sanity. See cms/README.md.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Read token, server-only. Required only for draft previews.
SANITY_API_READ_TOKEN=


# -----------------------------------------------------------------------------
# CRM (optional — future)
#
# The form handlers are structured so a CRM call can be added alongside the
# email send without changing the client. Lead source, campaign parameters and
# landing page are already captured and passed through.
# -----------------------------------------------------------------------------

CRM_API_KEY=
CRM_ENDPOINT=
